{
    "name": "cheating-daddy",
    "productName": "Cheating Daddy",
    "version": "0.8.0",
    "description": "A real-time desktop AI assistant for interviews, meetings, presentations, and screen-based workflows.",
    "main": "src/index.js",
    "scripts": {
        "start": "electron-forge start",
        "package": "electron-forge package",
        "make": "electron-forge make",
        "build:portable": "electron-builder --win portable --x64",
        "publish": "electron-forge publish",
        "check": "node scripts/check-source.js",
        "lint": "npm run check",
        "test": "node --test tests/*.test.js"
    },
    "engines": {
        "node": ">=22",
        "npm": ">=10"
    },
    "keywords": [
        "electron",
        "desktop-ai",
        "ai-assistant",
        "gemini",
        "groq",
        "screen-analysis",
        "interview-assistant"
    ],
    "author": {
        "name": "Aarya Mody"
    },
    "license": "GPL-3.0",
    "dependencies": {
        "@google/genai": "^2.18.0",
        "electron-squirrel-startup": "^1.0.1",
        "ws": "^8.19.0"
    },
    "devDependencies": {
        "@electron-forge/cli": "^7.11.2",
        "@electron-forge/maker-deb": "^7.11.2",
        "@electron-forge/maker-dmg": "^7.11.2",
        "@electron-forge/maker-rpm": "^7.11.2",
        "@electron-forge/maker-squirrel": "^7.11.2",
        "@electron-forge/maker-zip": "^7.11.2",
        "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
        "@electron-forge/plugin-fuses": "^7.11.2",
        "@electron/fuses": "^1.8.0",
        "@reforged/maker-appimage": "^5.0.0",
        "electron": "^43.4.1",
        "electron-builder": "^26.15.3"
    },
    "build": {
        "appId": "com.aaryamody.cheatingdaddy",
        "productName": "Cheating Daddy",
        "asar": true,
        "directories": {
            "output": "dist"
        },
        "win": {
            "icon": "src/assets/logo.ico",
            "target": [
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "Cheating-Daddy-Windows-x64.exe"
        }
    }
}
